---------------------------------------------------------
-- ระบบ 1: หยุดเวลา (Time Stop Logic)
---------------------------------------------------------
local isTimeStopped = false
local LocalPlayer = game.Players.LocalPlayer

local function toggleTimeStop()
    isTimeStopped = not isTimeStopped
    
    if isTimeStopped then
        TimeStopBtn.Text = "หยุดเวลา : ON"
        TimeStopBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Humanoid") and obj.Parent ~= LocalPlayer.Character then
                local root = obj.Parent:FindFirstChild("HumanoidRootPart")
                if root then
                    root.Anchored = true
                end
            end
        end
    else
        TimeStopBtn.Text = "หยุดเวลา : OFF"
        TimeStopBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Humanoid") and obj.Parent ~= LocalPlayer.Character then
                local root = obj.Parent:FindFirstChild("HumanoidRootPart")
                if root then
                    root.Anchored = false
                end
            end
        end
    end
end

TimeStopBtn.MouseButton1Click:Connect(toggleTimeStop)

---------------------------------------------------------
-- ระบบ 2: TPWalk (Teleport Walk)
---------------------------------------------------------
local tpWalkEnabled = false
local tpWalkSpeed = 2.5 -- สามารถปรับความเร็วได้ที่นี่
local RunService = game:GetService("RunService")
local tpWalkConnection = nil

local function toggleTPWalk()
    tpWalkEnabled = not tpWalkEnabled
    
    if tpWalkEnabled then
        TPWalkBtn.Text = "TPWalk : ON"
        TPWalkBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        
        tpWalkConnection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                local hum = char.Humanoid
                local hrp = char.HumanoidRootPart
                if hum.MoveDirection.Magnitude > 0 then
                    hrp.CFrame = hrp.CFrame + (hum.MoveDirection * tpWalkSpeed)
                end
            end
        end)
    else
        TPWalkBtn.Text = "TPWalk : OFF"
        TPWalkBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        
        if tpWalkConnection then
            tpWalkConnection:Disconnect()
            tpWalkConnection = nil
        end
    end
end

TPWalkBtn.MouseButton1Click:Connect(toggleTPWalk)
